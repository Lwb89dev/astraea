<?xml version="1.0" encoding="utf-8"?>
<!--
  Daily agenda: a 4x2 cell block.

  updatePeriodMillis is 30 minutes (the shortest Android honours) so the widget
  keeps itself current even if Astraea is never opened — the app also pushes a
  redraw whenever events change, and the provider redraws on ACTION_DATE_CHANGED
  at midnight. Widgets are added by long-pressing the home screen; the app has
  no "add widget" UI.
-->
<!--
  Widget-picker preview. Both attributes are needed:

    previewLayout  API 31+ — the modern picker inflates this and scales it, so
                   the user sees the real widget rather than a thumbnail.
    previewImage   API 24–30 — those pickers only understand a static image.

  Without either, the picker has nothing to draw: it inflates initialLayout
  instead, whose collection view (ListView/GridView) has no bound
  RemoteViewsService in the launcher's process, so it renders as an empty box
  that launchers then cover with their own cell-footprint grid. That is the
  "white grid of block numbers" this pair fixes. The preview resources carry
  their own static sample data for exactly that reason.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:widgetCategory="home_screen"
    android:description="@string/astraea_widget_day_label"
    android:initialLayout="@layout/astraea_widget_list"
    android:previewLayout="@layout/astraea_widget_preview_day"
    android:previewImage="@drawable/astraea_widget_preview_day"
    android:updatePeriodMillis="1800000"
    android:configure="com.example.astraea.AstraeaWidgetConfigActivity" />
