<?xml version="1.0" encoding="utf-8"?>
<!-- Weekly agenda: a 4x3 cell block. See the day widget's info for why it
     updates on a 30-minute period. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="150dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:widgetCategory="home_screen"
    android:description="@string/astraea_widget_week_label"
    android:initialLayout="@layout/astraea_widget_list"
    android:updatePeriodMillis="1800000"
    android:configure="com.example.astraea.AstraeaWidgetConfigActivity" />
