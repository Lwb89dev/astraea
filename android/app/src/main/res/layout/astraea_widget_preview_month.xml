<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget-picker preview for the monthly agenda (android:previewLayout).
  See astraea_widget_preview_day.xml for why a separate preview layout is
  needed at all.

  Mirrors astraea_widget_month.xml, with the GridView replaced by a static
  five-row grid: February 2026, today on the 12th, event dots on the days a
  sample month would have them. Blank leading cells match what
  MonthGridFactory emits before the 1st (its Cell.day is null there).

  GENERATED — the 35 cells are produced by the script embedded in the commit
  that added this file; if the month layout changes, regenerate rather than
  hand-editing 35 near-identical blocks.
-->
