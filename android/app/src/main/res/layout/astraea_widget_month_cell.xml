<?xml version="1.0" encoding="utf-8"?>
<!--
  One day cell in the month grid: the day number (circled when it's today) with
  a dot underneath when that day has events.

  The dot is an ImageView, not a <View>: RemoteViews only inflates a fixed set
  of view types and plain <View> isn't one of them — using it here is what made
  every cell of this widget show "Problem loading widget".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/cell_day"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="10sp" />

    <ImageView
        android:id="@+id/cell_dot"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginTop="1dp"
        android:contentDescription="@null"
        android:src="@drawable/astraea_widget_dot" />
</LinearLayout>
